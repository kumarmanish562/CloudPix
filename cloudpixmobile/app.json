{
  "expo": {
    "name": "CloudPix",
    "slug": "cloudpix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cloudpix",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e1730"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cloudpix.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e1730"
      },
      "package": "com.cloudpix.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you upload and back up your memories to CloudPix."
        }
      ]
    ]
  }
}

