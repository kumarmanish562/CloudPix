# ==========================================
# CloudPix Monorepo Root .gitignore
# Covers Backend (Spring Boot), Web (Next.js), Mobile (Expo), & Root
# ==========================================

# IDE & Editor Files
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
*~
.settings/
.project
.classpath
.factorypath
.apt_generated/
.springBeans
.sts4-cache/

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Environment Variables & Secrets (Keep example files committed)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key
*.jks
*.p8
*.p12

# Node & Package Managers
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnp
.pnp.*

# Java / Spring Boot Artifacts
target/
**/target/
!**/src/main/**/target/
!**/src/test/**/target/
.mvn/wrapper/maven-wrapper.jar

# Next.js Frontend
.next/
**/.next/
.next-e2e/
**/.next-e2e/
out/
**/out/
build/
**/build/
dist/
**/dist/
.vercel/

# Expo / React Native Mobile
.expo/
**/.expo/
.expo-shared/
**/.expo-shared/
web-build/
**/web-build/

# Testing & Coverage
coverage/
**/coverage/
playwright-report/
**/playwright-report/
test-results/
**/test-results/
*-result.log
**/*-result.log

# TypeScript & Cache
*.tsbuildinfo
next-env.d.ts

# Logs & Temporary Files
logs/
*.log
**/*.log
*.tmp
