# Database
DB_URL=jdbc:postgresql://localhost:5436/cloudpix
DB_USERNAME=your_local_db_username
DB_PASSWORD=replace_with_local_password

# Security — use a strong, randomly generated local value
JWT_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ImageKit
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key
IMAGEKIT_URL_ENDPOINT=https://your_imagekit_endpoint